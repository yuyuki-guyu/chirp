# Copy to `.env` and fill in. Do NOT commit `.env` — it holds your secrets.

# ---- Server ----
PORT=8899
# Path to the cookies.json produced by `npm run capture-cookies`.
COOKIES_FILE=./cookies.json
# Optional. When the server sits behind a tunnel / reverse proxy, set the public
# hostname so the MCP SDK's DNS-rebinding protection allows it.
# PUBLIC_HOST=chirp.example.com
# Optional. If set, clients must send this as `Authorization: Bearer <key>` or
# `x-api-key: <key>`.
# MCP_AUTH_KEY=change-me

# ---- X account ----
# Your handle without the @. Used for the x_post / x_reply URL.
X_USERNAME=

# ---- X web API (these rotate over time — see README "Survival guide") ----
# Optional. Overrides X's public web-app bearer token when it rotates.
# X_BEARER_TOKEN=
# Optional. Overrides the CreateTweet query id when X rotates it and posting
# starts returning empty results.
# X_CREATE_TWEET_QUERY_ID=
# Optional. Override the home-timeline query ids when X rotates them (the
# timeline tool then returns empty or errors).
# X_HOME_TIMELINE_QUERY_ID=
# X_HOME_LATEST_TIMELINE_QUERY_ID=
